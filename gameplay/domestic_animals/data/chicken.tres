; Uova (2026-11-17, richiesta utente): solo le femmine adulte; inverno, primavera, estate, autunno. Macello: 2 carne (metà del coniglio) e
; nessun osso, come la pernice (2026-11-17, richiesta utente).
[sub_resource type="Resource" id="LiveProduct_eggs"]
script = ExtResource("2_live_product")
product = "eggs"
per_day_by_season = Array[float]([0.0, 0.3, 0.25, 0.1])
is_female_only = true
adults_only = true

; Pollaio (2026-11-17, richiesta utente): 2 calorie al giorno (erano 3; valgono anche per le pernici selvatiche in tettoia,
; che usano queste regole), lettiera 0.03 al giorno, letame 0.015 (meno del coniglio), malattie come il coniglio, pulcini senza lettiera 70% (più resistenti dei coniglietti, 75%).

[ext_resource type="Script" uid="uid://cu4cyua5y4n1m" path="res://simulation/scripts/core/SecondaryResourceRules.gd" id="1_domestic_oats"]

; Avena (domestica) (2026-11-15, richiesta utente — ramo piante): le misure della pianta domestica (scheda
; gameplay/domestic_plants/data/oats.tres, domestic_resource_name). Non si trova in natura: nasce dalla Mietitura dell'orto
; seminato con l'avena selvatica dopo l'addomesticazione, poi dai campi. Granaglia nei vasi da semi (sfusa nella Casa delle
; granaglie), 1000 giorni; cruda non si mangia. Il suo carattere: è il cereale degli animali, 15 calorie per misura (gli
; altri cereali domestici 10). Alla Casa si pesta in fiocchi d'avena (oat_flakes).
[resource]
script = ExtResource("1_domestic_oats")
secondary_resource_name = "domestic_oats"
calories_per_unit = 0.0
category = 6
required_idea_id = "plant_domestication"
day_durability = 1000
space_per_unit = 0.5
stored_in_container = "seed_jar"
animal_calories_per_unit = 15.0

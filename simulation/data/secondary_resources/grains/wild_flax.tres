[ext_resource type="Script" uid="uid://cu4cyua5y4n1m" path="res://simulation/scripts/core/SecondaryResourceRules.gd" id="1_wild_flax"]

; Semi di lino selvatico (2026-11-15, richiesta utente — ramo piante; erano fasci di steli per la corda): raccolti a mano
; dall'erba, su 2 microcelle d'erba su 10, 4-8 per microcella. Solo dopo Filatura (prima "Risorsa sconosciuta"); d'estate,
; poco a fine primavera e inizio autunno. Granaglia nei vasi da semi come i semi selvatici dei cereali; non si mangiano.
; Servono a guadagnare i punti del Lino (raccolta) e a seminare l'orto delle prove (flax.tres). La corda di lino si fa
; solo con la fibra del lino domestico.
[resource]
script = ExtResource("1_wild_flax")
secondary_resource_name = "wild_flax"
calories_per_unit = 0.0
